<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.53.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editable list of stocks to scan; copied next to the exe so it can be changed without rebuilding. -->
    <Content Include="universe.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StockScout.Core.Tests" />
  </ItemGroup>

</Project>
