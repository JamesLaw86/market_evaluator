<UserControl x:Class="StockScout.App.Views.PickChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="280"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="4" Margin="0">
            <sp:WpfPlot x:Name="PricePlot"/>
        </Border>
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="4" Margin="0">
            <sp:WpfPlot x:Name="RelativePlot"/>
        </Border>
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="4" Margin="0">
            <sp:WpfPlot x:Name="VolumePlot"/>
        </Border>
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="4" Margin="0">
            <sp:WpfPlot x:Name="RsiPlot"/>
        </Border>
    </Grid>
</UserControl>
