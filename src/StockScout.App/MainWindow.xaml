<Window x:Class="StockScout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StockScout.App.ViewModels"
        xmlns:views="clr-namespace:StockScout.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="StockScout" Width="1440" Height="920" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <Window.Resources>
        <DataTemplate x:Key="BulletTemplate">
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,8,0" Foreground="{StaticResource TextMuted}" FontSize="14"/>
                <TextBlock Text="{Binding}" Style="{StaticResource Body}"/>
            </DockPanel>
        </DataTemplate>

        <Style x:Key="PickListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- header -->
            <RowDefinition Height="Auto"/> <!-- progress -->
            <RowDefinition Height="Auto"/> <!-- banners -->
            <RowDefinition Height="*"/>    <!-- content -->
            <RowDefinition Height="Auto"/> <!-- footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Market" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Markets}" SelectedItem="{Binding SelectedMarket}" Width="80"
                              VerticalContentAlignment="Center" Padding="8,6" Margin="0,0,12,0"
                              IsEnabled="{Binding FindPicksCommand.IsRunning, Converter={StaticResource InverseBool}}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding FindPicksCancelCommand}"
                            Visibility="{Binding FindPicksCommand.IsRunning, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Find stocks to buy" Style="{StaticResource PrimaryButton}" Command="{Binding FindPicksCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="StockScout" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="13"
                               Text="News-driven swing-trade ideas for US &amp; UK stocks: screened by code, judged by Claude"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="1" Height="4" Minimum="0" Maximum="1" Value="{Binding Progress}" BorderThickness="0"
                     Foreground="{StaticResource Accent}" Background="Transparent"
                     Visibility="{Binding FindPicksCommand.IsRunning, Converter={StaticResource BoolToVis}}"/>

        <!-- Banners -->
        <StackPanel Grid.Row="2" Margin="24,12,24,0">
            <Border Background="{StaticResource WarningBackground}" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding ApiKeyMissing, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningText}">
                    <Run FontWeight="SemiBold" Text="Offline mode: no ANTHROPIC_API_KEY found."/>
                    <Run Text="Picks will come from a rule-based fallback instead of Claude. To enable Claude, create a key at console.anthropic.com, run"/>
                    <Run FontFamily="Consolas" Text='setx ANTHROPIC_API_KEY "your-key"'/>
                    <Run Text="in a terminal, then restart the app."/>
                </TextBlock>
            </Border>
            <Border Background="#FEE2E2" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#991B1B"/>
            </Border>
        </StackPanel>

        <!-- Empty state -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620"
                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="What should I buy right now?" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>
            <TextBlock Style="{StaticResource Body}" TextAlignment="Center" Foreground="{StaticResource TextMuted}">
                <Run Text="Click"/> <Run FontWeight="SemiBold" Text="Find stocks to buy"/>
                <Run Text="and the app will:"/>
            </TextBlock>
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="1."/> Download a year of prices for every stock in the universe (<Run Text="{Binding UniverseText, Mode=OneWay}"/>).</TextBlock>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="2."/> Score each one on momentum, trend, volume and volatility.</TextBlock>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="3."/> Read the latest headlines for the strongest ~45 and rank by news attention.</TextBlock>
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,6"><Run FontWeight="SemiBold" Text="4."/> Send the top 25 to <Run Text="{Binding ModelName, Mode=OneWay}"/>, which picks 5-10 and explains why.</TextBlock>
                    <TextBlock Style="{StaticResource Body}"><Run FontWeight="SemiBold" Text="5."/> Validate the answer and chart every pick.</TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Results -->
        <TabControl Grid.Row="3" Margin="24,8,24,12" Background="Transparent" BorderThickness="0" Padding="0,12,0,0"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
            <TabItem Header="  Picks  " FontSize="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Picks}" SelectedItem="{Binding SelectedPick}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PickListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PickViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Ticker}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding LastPriceText}" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Return1MText, StringFormat={}{0} 1M}" FontSize="12"
                                                       Foreground="{Binding Return1M, Converter={StaticResource SignBrush}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource Badge}" VerticalAlignment="Top"
                                            Background="{Binding Conviction, Converter={StaticResource ConvictionBrush}}">
                                        <TextBlock Text="{Binding ConvictionText}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedPick}">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Title -->
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HorizonText}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Style="{StaticResource Badge}" Padding="12,4" Background="{Binding Conviction, Converter={StaticResource ConvictionBrush}}">
                                        <TextBlock Foreground="White" FontWeight="SemiBold" FontSize="14">
                                            <Run Text="Conviction"/> <Run Text="{Binding ConvictionText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontSize="26" Foreground="{StaticResource TextPrimary}">
                                        <Run FontWeight="Bold" Text="{Binding Ticker, Mode=OneWay}"/>
                                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextMuted}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding MarketAndSector}" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Stats -->
                            <WrapPanel Margin="0,0,0,0">
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel><TextBlock Text="Last price" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding LastPriceText}" Style="{StaticResource StatValue}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel><TextBlock Text="1 month" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Return1MText}" Style="{StaticResource StatValue}" Foreground="{Binding Return1M, Converter={StaticResource SignBrush}}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel><TextBlock Text="3 months" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding Return3MText}" Style="{StaticResource StatValue}" Foreground="{Binding Return3M, Converter={StaticResource SignBrush}}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel><TextBlock Text="RSI (14)" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding RsiText}" Style="{StaticResource StatValue}"/></StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatTile}">
                                    <StackPanel><TextBlock Text="Volatility (ann.)" Style="{StaticResource StatLabel}"/><TextBlock Text="{Binding VolatilityText}" Style="{StaticResource StatValue}"/></StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Thesis -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="WHY IT WAS PICKED" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="{Binding Thesis}" Style="{StaticResource Body}" FontSize="15"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="CATALYSTS" Style="{StaticResource SectionHeader}" Foreground="{StaticResource Positive}"/>
                                        <ItemsControl ItemsSource="{Binding Catalysts}" ItemTemplate="{StaticResource BulletTemplate}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="RISKS" Style="{StaticResource SectionHeader}" Foreground="{StaticResource Negative}"/>
                                        <ItemsControl ItemsSource="{Binding Risks}" ItemTemplate="{StaticResource BulletTemplate}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <views:PickChartsView Margin="0,0,0,12"/>

                            <!-- Headlines -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="HEADLINES THE ANALYST READ (★ = cited as evidence)" Style="{StaticResource SectionHeader}"/>
                                    <ItemsControl ItemsSource="{Binding Headlines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:HeadlineViewModel}">
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Left" Width="20" Text="★" Foreground="#F59E0B" FontSize="14">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSupporting}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock DockPanel.Dock="Left" Width="56" Text="{Binding Date}" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                                                    <TextBlock TextWrapping="Wrap" FontSize="14">
                                                        <Hyperlink Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding Link}" ToolTip="{Binding Link}">
                                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="  Market &amp; screening  " FontSize="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="MARKET SUMMARY" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding MarketSummary}" Style="{StaticResource Body}" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SCREENING FUNNEL" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="{Binding FunnelText}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=⚠ {0}}" Foreground="{StaticResource WarningText}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0">
                        <views:ScreenScatterView Report="{Binding Report}"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RunInfo}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="16,0,0,0"/>
                <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource TextPrimary}"/>
                    <Run Text="  ·  Educational project, not financial advice. Prices &amp; news: Yahoo Finance (unofficial API)."/>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
